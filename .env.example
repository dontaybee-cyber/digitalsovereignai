# Postgres — populated automatically when you provision Vercel Postgres
# (or Neon directly) and run `vercel env pull .env.local`. If connecting
# to a different Postgres provider, set POSTGRES_URL yourself.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Credentials for the /admin moderation panel (HTTP Basic Auth).
# Pick a long, random password — this guards your comments queue and
# subscriber export.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Resend — resend.com. Create an API key under API Keys, and verify
# digitalsovereignai.com (or whichever domain you send from) under
# Domains before sending anything real.
RESEND_API_KEY=

# Must be an address at a domain you've verified in Resend.
DISPATCH_FROM_EMAIL="Sovereign AI Journal <dispatch@digitalsovereignai.com>"
